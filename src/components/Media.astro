---
/**
 * Photo d'une fiche (optimisée au build par Astro), ou emplacement illustré
 * avec l'icône de la rubrique si aucune photo n'est renseignée.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon, { type IconName } from './Icon.astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  icon: IconName;
  iconSize?: number;
  /** Texte de l'emplacement vide (laisser vide pour icône seule). */
  label?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
}

const {
  src,
  alt = '',
  icon,
  iconSize = 24,
  label,
  widths = [400, 800],
  sizes = '(max-width: 600px) 100vw, 560px',
  loading = 'lazy',
} = Astro.props;
---

{
  src ? (
    <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} format="webp" quality={78} />
  ) : label ? (
    <div class="placeholder">
      <Icon name={icon} size={iconSize} stroke={1.4} />
      <span>{label}</span>
    </div>
  ) : (
    <Icon name={icon} size={iconSize} stroke={2} />
  )
}

---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page introuvable">
  <SiteHeader title="Oups, cette page n’existe pas" back={{ href: '/', label: 'Accueil' }} />
  <main class="page">
    <div class="wrap stack">
      <p class="empty">La fiche a peut-être été renommée ou supprimée.</p>
      <a class="btn" href="/">
        <Icon name="home" size={20} stroke={2.2} />
        Retour à l’accueil
      </a>
    </div>
  </main>
</Base>
